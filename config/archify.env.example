# Archify integration defaults for KRISHNA.
# Source this file only in the isolated architecture-intelligence process.
ARCHIFY_UPDATE_CHECK_DISABLED=1

# KRISHNA policy: read-only source analysis. Any output directory must be
# explicitly selected by the caller and must not be inside protected source
# paths unless it is a dedicated generated-artifact directory.
KRISHNA_ARCHIFY_MODE=read-only
KRISHNA_ARCHIFY_ALLOW_REPO_WRITE=0
KRISHNA_ARCHIFY_ALLOW_MERGE=0
KRISHNA_ARCHIFY_ALLOW_DEPLOY=0
