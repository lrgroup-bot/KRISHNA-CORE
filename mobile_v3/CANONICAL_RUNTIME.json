{
  "schema": 1,
  "version": "krishna-mobile-canonical-v1",
  "product": "KRISHNA Mobile",
  "canonical_android_source": "mobile_v3",
  "package_id": "com.krishna.mobile",
  "ui_role": "conversation-first mobile KRISHNA",
  "canonical_files": [
    "MainActivity.java",
    "MobileEdgeBot.java",
    "HawkeyeEvidenceCuratorBot.java",
    "HawkeyeEdgeMemory.java",
    "HawkeyeCrypto.java",
    "HawkeyeBackgroundSync.java",
    "HawkeyeSyncJobService.java",
    "HawkeyeDeviceProfiler.java",
    "index.html",
    "realtime-client.js",
    "HawkeyeMobileVision.java",
    "hawkeye-observer-ui.js"
  ],
  "build_workflow": ".github/workflows/build-mobile-v3.yml",
  "artifact_name": "KRISHNA-v3.8-HAWKEYE-Observer-APK",
  "pc_runtime_companion": {
    "path": "mobile/companion",
    "role": "pc-side compatibility/pairing support only",
    "canonical_android_ui": false,
    "may_delete_automatically": false,
    "retirement_gate": "real-device canonical APK pairing/conversation/camera/audio/offline-sync acceptance"
  },
  "boundaries": {
    "dashboard_ui": false,
    "project_admin_ui": false,
    "mobile_edge_preprocessing": true,
    "encrypted_hawkeye_evidence": true,
    "evidence_curator": true,
    "pc_ack_before_mobile_delete": true,
    "private_transport_only": true,
    "hawkeye_learning_observer": true,
    "local_object_tracking": true,
    "auto_zoom_when_supported": true,
    "user_browser_custom_tab": true,
    "local_photo_video_with_sidecar_data": true,
    "unknown_face_social_identity_search": false,
    "local_ocr": true,
    "local_devanagari_ocr": true,
    "local_barcode_scanning": true,
    "local_face_presence_tracking": true,
    "unknown_face_identity": "UNKNOWN",
    "local_pose_landmarks": true,
    "local_subject_segmentation": true,
    "lens_style_capture_inside_hawkeye": true,
    "google_lens_required": false,
    "gemini_permanent_key_on_pc_only": true,
    "gemini_selected_keyframe_mode": true,
    "gemini_live_ephemeral_token": true,
    "continuous_raw_camera_cloud_upload": false,
    "sensitive_scene_cloud_block": true
  },
  "research_integration": {
    "google_lens": "optional external handoff only; not required for HAWKEYE capture/OCR/search",
    "gemini_standard": "PC-owned credential; selected non-sensitive keyframes only after owner enables cloud mode",
    "gemini_live": "direct device WebSocket using one-use short-lived token minted by KRISHNA PC",
    "local_first": "ML Kit object/OCR/barcode/pose/face-presence/subject segmentation remain available without Gemini"
  }
}
